      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0713106384658441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt;= 30 THEN &apos;18-30&apos;&#10;ELSEIF [Age] &lt;= 40 THEN &apos;31-40&apos;&#10;ELSEIF [Age] &lt;= 50 THEN &apos;41-50&apos;&#10;ELSEIF [Age] &lt;= 60 THEN &apos;51-60&apos;&#10;ELSE &apos;60+&apos;&#10;END' />
      </column>
      <column caption='Balance Segment' datatype='string' name='[Calculation_0713106399866890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Balance] = 0 THEN &apos;Zero Balance&apos;&#10;ELSEIF [Balance] &lt;= 50000 THEN &apos;Low (1-50k)&apos;&#10;ELSEIF [Balance] &lt;= 100000 THEN &apos;Medium (50k-100k)&apos;&#10;ELSEIF [Balance] &lt;= 150000 THEN &apos;High (100k-150k)&apos;&#10;ELSE &apos;Very High (150k+)&apos;&#10;END' />
      </column>
      <column caption='Bank Tenure Group' datatype='string' name='[Calculation_0713106401828875]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tenure] &lt;= 2 THEN &apos;0-2 years&apos;&#10;ELSEIF [Tenure] &lt;= 5 THEN &apos;3-5 years&apos;&#10;ELSEIF [Tenure] &lt;= 8 THEN &apos;6-8 years&apos;&#10;ELSE &apos;9-10 years&apos;&#10;END' />
      </column>
      <column caption='B_KPI_AVgBalance' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_0713107468042259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Churn] = &apos;Yes&apos; THEN [Balance] ELSE NULL END)' />
      </column>
      <column caption='Age group' datatype='string' name='[Calculation_1651334802042881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 40 THEN &apos;Younger Customers&apos;&#10;ELSE &apos;Older Customers&apos;&#10;END' />
      </column>
